        ]
      },
      "strict": false,
      "autoescape": true,
      "expected": "&lt;b&gt;&lt;&gt;&amp;",
      "error": null
    },
    {
      "name": "join attr",
      "source": "{{values|join(', ', attribute='name')}}",
      "context": {
        "values": [
          {
            "name": "A"
          },
          {
            "name": "<B>"
          }
        ]
      },
      "strict": false,
      "autoescape": true,
      "expected": "A, &lt;B&gt;",
      "error": null
    },
    {
      "name": "sort",
      "source": "{{values|sort|join(',')}}",
      "context": {
        "values": [
          "b",
          "A",
          "a",
          "C"
        ]
      },
      "strict": false,
      "autoescape": true,
      "expected": "A,a,b,C",
      "error": null
    },
    {
      "name": "sort reverse sensitive",
      "source": "{{values|sort(reverse=true, case_sensitive=true)|join(',')}}",
      "context": {
        "values": [
          "b",
          "A",
          "a",
          "C"
        ]
      },
      "strict": false,
      "autoescape": true,
      "expected": "b,a,C,A",
      "error": null
    },
    {
      "name": "sort attribute",
      "source": "{{values|sort(attribute='age')|map(attribute='name')|join(',')}}",
      "context": {
        "values": [
          {
            "name": "B",
            "age": 2
          },
          {
            "name": "A",
            "age": 1
          }
        ]
      },
      "strict": false,
      "autoescape": true,
      "expected": "A,B",
      "error": null
    },
    {
      "name": "reverse list",
      "source": "{{values|reverse|join(',')}}",
      "context": {
        "values": [
          1,
          2,
          3
        ]
      },
      "strict": false,
      "autoescape": true,
      "expected": "3,2,1",
      "error": null
