{
  "jinja": "3.1.6",
  "markupsafe": "3.0.3",
  "cases": [
    {
      "name": "escape",
      "source": "{{ value|escape }}",
      "context": {
        "value": " <b>hello & bye</b> "
      },
      "strict": false,
      "autoescape": true,
      "expected": " &lt;b&gt;hello &amp; bye&lt;/b&gt; ",
      "error": null
    },
    {
      "name": "e",
      "source": "{{ value|e }}",
      "context": {
        "value": " <b>hello & bye</b> "
      },
      "strict": false,
      "autoescape": true,
      "expected": " &lt;b&gt;hello &amp; bye&lt;/b&gt; ",
      "error": null
    },
    {
      "name": "safe",
      "source": "{{ value|safe }}",
      "context": {
        "value": " <b>hello & bye</b> "
      },
      "strict": false,
      "autoescape": true,
      "expected": " <b>hello & bye</b> ",
      "error": null
    },
    {
      "name": "upper",
      "source": "{{ value|upper }}",
      "context": {
        "value": " <b>hello & bye</b> "
      },
      "strict": false,
      "autoescape": true,
      "expected": " &lt;B&gt;HELLO &amp; BYE&lt;/B&gt; ",
      "error": null
    },
    {
