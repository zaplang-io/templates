        "value": null
      },
      "strict": false,
      "autoescape": true,
      "expected": "None",
      "error": null
    },
    {
      "name": "default boolean",
      "source": "{{value|d('fallback', true)}}",
      "context": {
        "value": 0
      },
      "strict": false,
      "autoescape": true,
      "expected": "fallback",
      "error": null
    },
    {
      "name": "default keyword",
      "source": "{{missing|default(boolean=true, default_value='yes')}}",
      "context": {},
      "strict": false,
      "autoescape": true,
      "expected": "yes",
      "error": null
    },
    {
      "name": "first last",
      "source": "{{values|first}}/{{values|last}}",
      "context": {
        "values": [
          "<a>",
          "<z>"
